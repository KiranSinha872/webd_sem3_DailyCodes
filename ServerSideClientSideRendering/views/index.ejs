<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>


    <% if(students.length===0){%>
        <p>no students</p>
        <% }else{%>
            <% students.forEach((elem)=>{%>

                <div style="border: 2px solid black;">
                    <p><span>id: </span>
                        <%=elem.id%>
                    </p>
                    <p><span>first_name: </span>
                        <%=elem.first_name%>
                    </p>
                    <p><span>last_name: </span>
                        <%=elem.last_name%>
                    </p>
                    <p><span>email: </span>
                        <%=elem.email%>
                    </p>
                    <p><span>gender: </span>
                        <%=elem.gender%>
                    </p>
                    <p><span>ip_address: </span>
                        <%=elem.ip_address%>
                    </p>
                </div>
                <% })%>
                    <% }%>






</body>

</html>